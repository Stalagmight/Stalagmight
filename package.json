{
  "name": "stalagmight",
  "private": true,
  "version": "0.5.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "playwright test",
    "test:ui:smoke": "playwright test --grep @smoke",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "lint:e2e-parallel": "node scripts/check-e2e-parallel-safe.mjs",
    "lint:rust-file-size": "node scripts/check-rust-file-size.mjs",
    "lint:rust-file-size:test": "node scripts/check-rust-file-size.test.mjs",
    "lint:ts-file-size": "node scripts/check-ts-file-size.mjs",
    "lint:ts-file-size:test": "node scripts/check-ts-file-size.test.mjs",
    "lint:private-leaks": "node scripts/check-private-leaks.mjs",
    "lint:private-leaks:test": "node scripts/check-private-leaks.test.mjs",
    "lint:readonly-gates": "node scripts/check-readonly-gates.mjs",
    "lint:readonly-gates:test": "node scripts/check-readonly-gates.test.mjs",
    "lint:no-em-dash": "node scripts/check-no-em-dash.mjs",
    "lint:no-em-dash:test": "node scripts/check-no-em-dash.test.mjs",
    "lint:third-party": "node scripts/check-third-party-licenses.mjs",
    "lint:third-party:test": "node scripts/check-third-party-licenses.test.mjs",
    "lint:updater-pubkey": "node scripts/check-updater-pubkey.mjs",
    "lint:updater-pubkey:test": "node scripts/check-updater-pubkey.test.mjs",
    "lint:test-ids": "node scripts/check-test-ids.mjs",
    "lint:test-ids:test": "node scripts/check-test-ids.test.mjs",
    "lint:pw-timing:test": "node scripts/pw-timing-reporter.test.mjs && node scripts/pw-timing-summary.test.mjs",
    "coverage:ui": "E2E_COVERAGE=1 VITE_COVERAGE=1 pnpm test:ui",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "gen:ipc-types": "cargo run --manifest-path src-tauri/Cargo.toml --features ipc-typegen --example gen_ipc_types",
    "gen:third-party": "node scripts/gen-third-party-licenses.mjs",
    "gen:updater-manifest": "node scripts/gen-updater-manifest.mjs",
    "gen:updater-manifest:test": "node scripts/gen-updater-manifest.test.mjs",
    "test:all": "pnpm test && pnpm test:ui",
    "release": "./scripts/release.sh",
    "typecheck:agent": "tsc -p tsconfig.agent.json",
    "typecheck:playwright": "tsc -p tsconfig.playwright.json --noEmit",
    "test:mock-contract": "vitest run src/test/__tests__/mockContract.test.ts",
    "agent:smoke": "tsx e2e/agent/smoke.ts",
    "agent:scenarios": "tsx e2e/agent/scenarios-smoke.ts",
    "agent:journeys": "tsx e2e/agent/journeys-run.ts",
    "agent:scenario": "tsx e2e/agent/scenario-run.ts",
    "agent:fuzz-shrink": "tsx e2e/agent/fuzz-shrink.ts",
    "agent:fuzz-matrix": "tsx e2e/agent/fuzz-matrix.ts",
    "agent:mcp": "tsx e2e/agent/mcp/server.ts",
    "agent:bridge": "tsx e2e/agent/mcp/bridge.ts",
    "agent:mcp:smoke": "tsx e2e/agent/mcp/smoke-client.ts",
    "agent:http-probe": "tsx e2e/agent/session-http-probe.ts",
    "agent:replay:gen": "node scripts/generate-replay.mjs",
    "agent:report": "node scripts/generate-repro-report.mjs"
  },
  "dependencies": {
    "@mapbox/tiny-sdf": "^2.2.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.3",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^7.2.1",
    "maplibre-gl": "^6.16.0",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.57.0",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "nyc": "^17.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vite-plugin-istanbul": "^7.2.1",
    "vitest": "^3.2.7",
    "webdriverio": "^9.23.0",
    "zod": "^4.4.3"
  }
}
