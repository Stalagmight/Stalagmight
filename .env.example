# Copy to .env and fill in real values.
# .env is gitignored - never commit secrets.

# Telemetry endpoint (Cloudflare Worker URL, including the /v1/events path).
# Required for production builds with --features telemetry, and it must be a
# full URL with a scheme: build.rs rejects an empty or scheme-less value rather
# than compiling an endpoint the app can never reach. That applies to local dev
# too, not only releases - scripts/dev.sh and scripts/mac-build.sh decide whether
# to build with telemetry by testing only that this is non-empty, so a value that
# is whitespace-only or missing its scheme turns the feature on and then fails
# the build from cargo rather than from the script. Releases built in CI take
# this from the TELEMETRY_ENDPOINT repo secret, not from this file.
# See telemetry-worker/wrangler.toml for the route.
# When set, scripts/dev.sh builds the dev app with telemetry on by default
# (dogfooding) - dev sessions report as "<version>-dev-<hash>". Leave it empty
# and dev builds plain, which is why there is no placeholder value here: a
# straight `cp .env.example .env` must not turn telemetry on and aim it at a
# host that does not exist.
# Example shape: https://usage.example.com/v1/events
TELEMETRY_ENDPOINT=

# Optional: set to 0 to compile telemetry into the dev build but leave it OFF at
# startup (scripts/dev.sh defaults it to 1 = on when TELEMETRY_ENDPOINT is set).
# STALAGMIGHT_TELEMETRY_ENABLED=1

# ==================== SpeleoDB ==================== #

# Live API tests only; loaded automatically from .env. App login uses its Settings.
SPELEODB_INSTANCE_URL="http://<placeholder>"  # http:// or https://

# Required: supplied token (validated independently from email login)
SPELEODB_OAUTH_TOKEN="<placeholder>"

# Required: email/password (both authentication paths are tested)
SPELEODB_EMAIL="<placeholder>"
SPELEODB_PASSWORD="<placeholder>"

# API test timeout in milliseconds, including file transfers; defaults to 120s.
SPELEODB_API_TIMEOUT_MS=120000
SPELEODB_API_RETRY_COUNT=3
SPELEODB_API_TEST_ENABLED=false
