*.stalx
*.tml
*.tmlu
*.mak
*.dat
*.wpj
*.srv
*.dmp
*.gpx
*.csv

# Test artifacts
playwright-report/
.playwright-mcp/
test-results/
.pnpm-store/
.e2e-build-marker
e2e-playwright/screenshots/
.cargo_build/
docs/coverage/
docs/transcripts/
.tmp/

# WebdriverIO test logs
wdio-logs/

# Script build artifacts
scripts/lib/slice-rs/target/
scripts/lib/slice-rs/Cargo.lock

# Workspace-excluded vendored crate: its tests (CI check job, #494) build into
# its own target dir, which src-tauri/target/ above does not cover.
src-tauri/vendor/compass_data/target/

# Tier 2 OS helper: ensureHelperBuilt() builds into CARGO_TARGET_DIR, but a
# hand-run `cargo build` in the crate dir drops a target/ here. Cargo.lock IS
# tracked (it pins the helper's own deps and is outside the license gate's
# src-tauri/Cargo.lock scope).
e2e/agent/os/helper/target/

# macOS remote build artifacts
build/

# Android build artifacts
src-tauri/gen/android/.gradle/
src-tauri/gen/android/app/build/
src-tauri/gen/android/build/
src-tauri/gen/android/buildSrc/build/
src-tauri/gen/android/local.properties

# Cloudflare Worker
telemetry-worker/wrangler.toml
telemetry-worker/.wrangler/

# Claude Code local/runtime state (machine-specific; must not be tracked)
.claude/*.lock
.claude/settings.local.json
CLAUDE.local.md

# Agent harness per-session artifacts (screenshots, action logs, state snapshots)
.agent-artifacts/

# LLM agent-harness bridge runtime artifacts (#262) - never commit
.agent-bridge/

# Per-contributor /pre-pr instrumentation - local by policy.
# Unanchored so a nested worktree's own .claude/ log is covered too.
**/.claude/review-log.jsonl
# Python bytecode (repo-wide; scripts/ralph emits it)
__pycache__/

# cargo-fuzz crate (src-tauri/fuzz): build output, the lockfile run.sh copies
# from src-tauri/Cargo.lock, and local corpora / crash artifacts (never commit
# a corpus: seeds are generated in code)
src-tauri/fuzz/target/
src-tauri/fuzz/Cargo.lock
src-tauri/fuzz/work/
src-tauri/fuzz/corpus/
src-tauri/fuzz/artifacts/
src-tauri/fuzz/coverage/
