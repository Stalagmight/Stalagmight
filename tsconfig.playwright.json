{
  // The Playwright program (e2e-playwright/ + playwright.config.ts). Shared
  // options and strictness: tsconfig.base.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // The specs import from `src/`, which pulls ~200 app files into this
    // program. These two keep it buildable when that reach grows: without
    // `jsx`, the first spec whose import chain touches a .tsx fails the gate
    // with an error that has nothing to do with the spec.
    "jsx": "react-jsx",
    // `types` is an allowlist: naming it at all drops the implicit @types/node
    // that playwright.config.ts and the specs rely on for `process`.
    "types": ["vite/client", "node"],

    // The program is ~200 src/ files bigger than its own tree; the cache makes
    // a re-run after a one-spec edit cheap. Its own file, so the three
    // programs never overwrite each other's build info.
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.playwright.tsbuildinfo"
  },
  "include": ["e2e-playwright/**/*", "playwright.config.ts"]
}
