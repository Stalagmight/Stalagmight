{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stalagmight",
  "version": "0.5.0",
  "identifier": "com.stalagmight.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stalagmight",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1a1a2e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost stalagmight-tiles: http://stalagmight-tiles.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self' http://localhost:1420; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' http://localhost:1420; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 stalagmight-tiles: http://stalagmight-tiles.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": ["stalx"],
        "name": "Stalagmight Project",
        "description": "Stalagmight Project",
        "mimeType": "application/vnd.stalagmight.project",
        "role": "Editor",
        "rank": "Owner",
        "contentTypes": ["com.stalagmight.desktop.stalx"],
        "exportedType": {
          "identifier": "com.stalagmight.desktop.stalx",
          "conformsTo": ["public.data", "public.database"]
        }
      },
      {
        "ext": ["tml", "tmlu"],
        "name": "Ariane Survey",
        "description": "Ariane Survey",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": ["com.arianesline.ariane.tml", "com.arianesline.ariane.tmlu"]
      }
    ]
  },
  "plugins": {}
}
